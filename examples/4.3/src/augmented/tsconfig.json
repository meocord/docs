{
  // A program of its own: an augmentation reaches every file compiled with it, so the app's own theme tokens and typed
  // mock values would otherwise apply to every example. `files`, not `include`, so a renamed example fails
  "extends": "../../tsconfig.json",
  "include": [],
  "files": ["types/theme.d.ts", "vip.app.ts", "types/meocord-testing.d.ts", "typed-values.spec.ts"]
}
