{
  "name": "meocord-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "start:dev": "rm -rf .next && mkdir -p .next/dev/node_modules && PORT=${PORT:-3000} UPSTREAM_PORT=${UPSTREAM_PORT:-3001} CSP_PROXY_CHILD='bun --bun next dev' bun scripts/csp-hash-proxy.mjs",
    "build": "rm -rf .next && bun run search:build && bun --bun next build",
    "search:build": "bun scripts/search-build.ts",
    "serve": "bun scripts/serve-standalone.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "budget:js": "bun scripts/check-js-budget.ts",
    "test:e2e": "bun --bun x playwright test",
    "icons": "bun scripts/generate-icons.ts",
    "check:dev-routes": "bun e2e/dev-routes.ts",
    "versions:sync": "bun scripts/sync-versions.ts",
    "api:generate": "bun scripts/api-generate.ts",
    "content:check": "bun scripts/check-content.ts",
    "brand:sync": "bun scripts/brand-sync.ts",
    "brand:check": "bun scripts/brand-sync.ts --check",
    "content:backport": "bun scripts/backport.ts",
    "examples:check": "bun scripts/check-examples.ts",
    "home:trace": "bun scripts/home-trace.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@meonode/ui": "^3.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "meo-canvas": "^10.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@meonode/compiler": "^0.9.0",
    "@next/eslint-plugin-next": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@sigstore/bundle": "^5.0.0",
    "@sigstore/protobuf-specs": "^0.5.2",
    "@sigstore/tuf": "^5.0.0",
    "@sigstore/verify": "^4.1.2",
    "@types/bun": "^1.4.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-istanbul": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "github-slugger": "^2.0.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "semver": "^7.8.5",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
